# ==============================================================================
#  Gitignore - OEE Big Data Analytics Pipeline (PySpark / Hadoop / Power BI)
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# C extensions & packaging
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments (Industry best practice: never commit venvs)
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Logs and runtime diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Big Data Generated datasets & outputs (do not commit dynamic data)
data/raw/
data/processed/
data/streaming/input/
data/streaming/checkpoint/
streaming/checkpoint/
streaming/data/streaming/checkpoint/
*.parquet
*.csv.crc
*.parquet.crc

# Spark & Hadoop local runtime artifacts
spark-warehouse/
metastore_db/
derby.log
*.jar

# Power BI temporary & backup lock files
*.pbit.bak
*.pbix.bak
~*

# OS Generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs and Code Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Docker local overrides
docker-compose.override.yml
